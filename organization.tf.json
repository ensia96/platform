{
  "resource": {
    "tailscale_acl": {
      "main": { "acl": "${jsonencode(local.tailscale-acl)}" }
    },
    "tailscale_tailnet_key": {
      "main": {
        "depends_on": ["tailscale_acl.main"],
        "ephemeral": true,
        "preauthorized": true,
        "reusable": true,
        "tags": ["${local.tailscale-tag}"]
      }
    }
  }
}

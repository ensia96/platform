{
  "resource": {
    "oci_network_load_balancer_backend": {
      "https": {
        "backend_set_name": "${oci_network_load_balancer_backend_set.https.name}",
        "network_load_balancer_id": "${oci_network_load_balancer_network_load_balancer.main.id}",
        "port": 443,
        "target_id": "${oci_core_instance.main.id}"
      }
    },
    "oci_network_load_balancer_backend_set": {
      "https": {
        "health_checker": { "protocol": "TCP" },
        "is_preserve_source": false,
        "name": "https",
        "network_load_balancer_id": "${oci_network_load_balancer_network_load_balancer.main.id}",
        "policy": "FIVE_TUPLE"
      }
    },
    "oci_network_load_balancer_listener": {
      "https": {
        "default_backend_set_name": "${oci_network_load_balancer_backend_set.https.name}",
        "name": "https",
        "network_load_balancer_id": "${oci_network_load_balancer_network_load_balancer.main.id}",
        "port": 443,
        "protocol": "TCP"
      }
    },
    "oci_network_load_balancer_network_load_balancer": {
      "main": {
        "compartment_id": "${oci_identity_compartment.main.id}",
        "display_name": "${local.project}-network-load-balancer",
        "is_private": false,
        "network_security_group_ids": [
          "${oci_core_network_security_group.load-balancer.id}"
        ],
        "reserved_ips": [{ "id": "${oci_core_public_ip.main.id}" }],
        "subnet_id": "${oci_core_subnet.public.id}"
      }
    }
  }
}
